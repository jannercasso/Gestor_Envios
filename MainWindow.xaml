<Window x:Class="GestorEnvios.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📦 Gestor de Envíos"
        WindowState="Maximized" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Estilos para ScrollBars más delgados -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" 
                   Text="📦 GESTOR DE ENVÍOS" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="#1976D2"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- Carga de archivo único -->
        <GroupBox Grid.Row="1" 
                  Header="📂 Seleccionar Archivo"
                  Margin="0,0,0,10"
                  Padding="10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" x:Name="txtArchivo" IsReadOnly="True" 
                         VerticalContentAlignment="Center" Background="#F5F5F5" 
                         Text="Seleccionar Documento"
                         Height="30"
                         Margin="0,0,10,0"/>
                
                <Button Grid.Row="0" Grid.Column="1" 
                        Content="📂 Seleccionar"
                        Background="#2196F3"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="10,5"
                        Click="BtnSeleccionarArchivo_Click"
                        Height="30"/>
            </Grid>
        </GroupBox>

        <!-- Botones -->        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnProcesar" 
                    Content="▶ PROCESAR DATOS"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="15,8"
                    Click="BtnProcesar_Click"
                    IsEnabled="False"
                    Width="200"/>
            <Button x:Name="btnLimpiar" 
                    Content="🗑️ LIMPIAR"
                    Background="#f44336"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="15,8"
                    Click="BtnLimpiar_Click"
                    Width="120"
                    Margin="10,0,0,0"/>
            
            <TextBlock x:Name="txtStatus" 
                    Text="✅ Listo" 
                    VerticalAlignment="Center"
                    Margin="20,0,0,0"
                    FontWeight="Bold"
                    FontSize="14"
                    Foreground="Green"/>
        </StackPanel>

        <!-- Tabla de resultados - SIN AlternatingRowBackground -->
        <DataGrid Grid.Row="3" 
                  x:Name="dgDatos"
                  AutoGenerateColumns="False"
                  Margin="0,0,0,5"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <!-- Estilo para encabezados -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#32AC5C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderBrush" Value="#2A8F4A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            
            <!-- Estilo para filas y celdas -->
            <DataGrid.Resources>
                <!-- Desactivar el color azul por defecto -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#32AC5C"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#32AC5C"/>
                
                <!-- Estilo para celdas - Hereda el color de la fila -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Background}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#32AC5C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4AC87C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <!-- Estilo para filas -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#32AC5C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4AC87C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Shipment Number" Binding="{Binding ShipmentNumber}" Width="130"/>
                <DataGridTextColumn Header="Delivery" Binding="{Binding Delivery}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Shipment type" Binding="{Binding ShipmentType}" Width="100"/>
                <DataGridTextColumn Header="Ship-to party" Binding="{Binding ShipToParty}" Width="120"/>
                <DataGridTextColumn Header="Vehicle Type" Binding="{Binding VehicleType}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150"/>
                <DataGridTextColumn Header="Service agent" Binding="{Binding ServiceAgent}" Width="120"/>
                <DataGridTextColumn Header="Name 1" Binding="{Binding Name1}" Width="150"/>
                <DataGridTextColumn Header="Delivery Date" Binding="{Binding DeliveryDate}" Width="120"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="80"/>
                <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="80"/>
                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"/>
                <DataGridTextColumn Header="Order Number" Binding="{Binding OrderNumber}" Width="120"/>
                <DataGridTextColumn Header="Street" Binding="{Binding Street}" Width="200"/>
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                <DataGridTextColumn Header="Fecha1" Binding="{Binding Fecha1}" Width="100"/>
                <DataGridTextColumn Header="Fecha2" Binding="{Binding Fecha2}" Width="100"/>
                <DataGridTextColumn Header="Tipo1" Binding="{Binding Tipo1}" Width="80"/>
                <DataGridTextColumn Header="Tipo2" Binding="{Binding Tipo2}" Width="80"/>
                <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Barra de estado -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="statusBarText" Text="Selecciona un archivo"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="statusBarCount" Text="0 registros"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="statusBarErrores" Text="" Foreground="Red"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>