<Window x:Class="GestorEnvios.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GestorEnvios"
        Title="🚚 Gestor de Envíos Procter"
        Icon="/Procter.ico"
        WindowState="Maximized"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <local:DarkenColorConverter x:Key="DarkenColorConverter"/>
        <local:DarkerColorConverter x:Key="DarkerColorConverter"/>

        <SolidColorBrush x:Key="GreenNormal" Color="#32AC5C"/>
        <SolidColorBrush x:Key="GreenHover" Color="#4AC87C"/>
        <SolidColorBrush x:Key="GreenDark" Color="#2A8F4A"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="White"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource Self}, Converter={StaticResource DarkenColorConverter}}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource Self}, Converter={StaticResource DarkerColorConverter}}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0BEC5"/>
                    <Setter Property="Foreground" Value="#78909C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================ -->
        <!-- ESTILO SCROLLBAR CON SOPORTE HORIZONTAL Y VERTICAL -->
        <!-- ============================================ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#F5F5F5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="14"/>
                            </Grid.RowDefinitions>

                            <RepeatButton Grid.Row="0"
                                          Command="ScrollBar.LineUpCommand"
                                          Background="#F0F0F0"
                                          BorderBrush="#D0D0D0"
                                          BorderThickness="0,0,0,1"
                                          Cursor="Hand"
                                          Content="▲"
                                          FontSize="8"
                                          Foreground="#666666"/>

                            <Track x:Name="PART_Track"
                                   Grid.Row="1"
                                   Orientation="Vertical"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Background="#C8C8C8"
                                           BorderBrush="#A0A0A0"
                                           BorderThickness="1"
                                           Width="6"
                                           MinHeight="30">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3"
                                                        Width="{TemplateBinding Width}"
                                                        Height="{TemplateBinding Height}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#A8A8A8"/>
                                                        <Setter Property="Width" Value="7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Background" Value="#32AC5C"/>
                                                        <Setter Property="Width" Value="7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <RepeatButton Grid.Row="2"
                                          Command="ScrollBar.LineDownCommand"
                                          Background="#F0F0F0"
                                          BorderBrush="#D0D0D0"
                                          BorderThickness="0,1,0,0"
                                          Cursor="Hand"
                                          Content="▼"
                                          FontSize="8"
                                          Foreground="#666666"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- ✅ TRIGGER HORIZONTAL (igual que en PreviewWindow) -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="NaN"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#F5F5F5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>

                                    <RepeatButton Grid.Column="0"
                                                  Command="ScrollBar.LineLeftCommand"
                                                  Background="#F0F0F0"
                                                  BorderBrush="#D0D0D0"
                                                  BorderThickness="0,0,1,0"
                                                  Cursor="Hand"
                                                  Content="◄"
                                                  FontSize="8"
                                                  Foreground="#666666"/>

                                    <Track x:Name="PART_Track"
                                           Grid.Column="1"
                                           Orientation="Horizontal"
                                           IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Background="Transparent"
                                                          BorderThickness="0"/>
                                        </Track.DecreaseRepeatButton>

                                        <Track.Thumb>
                                            <Thumb Background="#C8C8C8"
                                                   BorderBrush="#A0A0A0"
                                                   BorderThickness="1"
                                                   Height="6"
                                                   MinWidth="30">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3"
                                                                Width="{TemplateBinding Width}"
                                                                Height="{TemplateBinding Height}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                                <Thumb.Style>
                                                    <Style TargetType="Thumb">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#A8A8A8"/>
                                                                <Setter Property="Height" Value="7"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter Property="Background" Value="#32AC5C"/>
                                                                <Setter Property="Height" Value="7"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Thumb.Style>
                                            </Thumb>
                                        </Track.Thumb>

                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Background="Transparent"
                                                          BorderThickness="0"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>

                                    <RepeatButton Grid.Column="2"
                                                  Command="ScrollBar.LineRightCommand"
                                                  Background="#F0F0F0"
                                                  BorderBrush="#D0D0D0"
                                                  BorderThickness="1,0,0,0"
                                                  Cursor="Hand"
                                                  Content="►"
                                                  FontSize="8"
                                                  Foreground="#666666"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="🚚 GESTOR DE ENVÍOS PROCTER"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1976D2"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <GroupBox Grid.Row="1"
                  Header="📂 Seleccionar Archivo"
                  Margin="0,0,0,10"
                  Padding="10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" x:Name="txtArchivo" IsReadOnly="True"
                         VerticalContentAlignment="Center" Background="#F5F5F5"
                         Text="Seleccionar Documento"
                         Height="30"
                         Margin="0,0,10,0"/>

                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="btnSeleccionarArchivo"
                        Content="📂 Seleccionar"
                        Background="#2196F3"
                        Padding="10,5"
                        Click="BtnSeleccionarArchivo_Click"
                        Height="30"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnProcesar"
                    Content="▶ Procesar Datos"
                    Background="#4CAF50"
                    Padding="15,8"
                    Click="BtnProcesar_Click"
                    IsEnabled="False"
                    Width="200"/>

            <Button x:Name="btnLimpiar"
                    Content="🗑️ Limpiar"
                    Background="#757575"
                    Padding="15,8"
                    Click="BtnLimpiar_Click"
                    IsEnabled="False"
                    Width="120"
                    Margin="10,0,0,0"/>

            <Button x:Name="btnVerVistaPrevia"
                    Content="👁️ Ver Vista Previa"
                    Background="#8BC34A"
                    Padding="15,8"
                    Click="BtnVerVistaPrevia_Click"
                    Width="160"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"/>

            <!-- ✅ Botón Plan B: OCULTO Y DESHABILITADO por defecto -->
            <Button x:Name="btnCargarEnvios"
                    Content="📦 Cargar Envíos"
                    Background="#FF9800"
                    Padding="15,8"
                    Click="BtnCargarEnvios_Click"
                    Width="160"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    IsEnabled="False"/>

            <CheckBox x:Name="chkFiltrarTransportadora"
                      Content="🚚 Filtrar por Transportadora"
                      VerticalAlignment="Center"
                      Margin="20,0,10,0"
                      FontWeight="SemiBold"
                      IsEnabled="False"
                      Checked="ChkFiltrarTransportadora_Checked"
                      Unchecked="ChkFiltrarTransportadora_Unchecked"/>

            <ComboBox x:Name="cmbTransportadoras"
                      Width="200"
                      Height="30"
                      VerticalAlignment="Center"
                      IsEnabled="False"
                      SelectionChanged="CmbTransportadoras_SelectionChanged"
                      DisplayMemberPath="Key"
                      SelectedValuePath="Key"/>

            <TextBlock x:Name="txtStatus"
                       Text="✅ Listo"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="Green"/>
        </StackPanel>

        <Grid Grid.Row="3">

            <!-- DataGrid ESTÁNDAR -->
            <DataGrid x:Name="dgDatos"
                      AutoGenerateColumns="False"
                      Margin="0,0,0,5"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="All"
                      RowHeaderWidth="0"
                      MinColumnWidth="120"
                      MaxColumnWidth="300"
                      IsReadOnly="True"
                      Visibility="Visible">

                <DataGrid.Resources>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="PanningMode" Value="Both"/>
                    </Style>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#32AC5C"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#32AC5C"/>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Background}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#32AC5C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4AC87C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#32AC5C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4AC87C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#32AC5C"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#2A8F4A"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="5,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Shipment Number" Binding="{Binding ShipmentNumber}" Width="130"/>
                    <DataGridTextColumn Header="Delivery" Binding="{Binding Delivery}" Width="100"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="Shipment type" Binding="{Binding ShipmentType}" Width="100"/>
                    <DataGridTextColumn Header="Ship-to party" Binding="{Binding ShipToParty}" Width="120"/>
                    <DataGridTextColumn Header="Vehicle Type" Binding="{Binding VehicleType}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150"/>
                    <DataGridTextColumn Header="Service agent" Binding="{Binding ServiceAgent}" Width="120"/>
                    <DataGridTextColumn Header="Name 1" Binding="{Binding Name1}" Width="150"/>
                    <DataGridTextColumn Header="Delivery Date" Binding="{Binding DeliveryDate}" Width="120"/>
                    <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="80"/>
                    <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="80"/>
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"/>
                    <DataGridTextColumn Header="Order Number" Binding="{Binding OrderNumber}" Width="120"/>
                    <DataGridTextColumn Header="Street" Binding="{Binding Street}" Width="200"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                    <DataGridTextColumn Header="Fecha1" Binding="{Binding Fecha1}" Width="100"/>
                    <DataGridTextColumn Header="Fecha2" Binding="{Binding Fecha2}" Width="100"/>
                    <DataGridTextColumn Header="Tipo1" Binding="{Binding Tipo1}" Width="80"/>
                    <DataGridTextColumn Header="Tipo2" Binding="{Binding Tipo2}" Width="80"/>
                    <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- DataGrid PLAN B -->
            <DataGrid x:Name="dgEnviosRaw"
          AutoGenerateColumns="False"
          Margin="0,0,0,5"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserReorderColumns="True"
          CanUserResizeColumns="True"
          CanUserSortColumns="True"
          GridLinesVisibility="All"
          RowHeaderWidth="0"
          MinColumnWidth="100"
          MaxColumnWidth="300"
          IsReadOnly="True"
          Visibility="Collapsed">

                <DataGrid.Resources>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="PanningMode" Value="Both"/>
                    </Style>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF9800"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF9800"/>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Background}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFB74D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <!-- ✅ Fila: rojo si TieneError, si no los colores normales -->
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFB74D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- ✅ Filas con error → rojo SIEMPRE + ToolTip SOLO en estas filas -->
                            <DataTrigger Binding="{Binding TieneError}" Value="True">
                                <Setter Property="Background" Value="#FFCDD2"/>
                                <Setter Property="Foreground" Value="#B71C1C"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <!-- ✅ ToolTip SOLO cuando hay error -->
                                <Setter Property="ToolTip" Value="{Binding MensajeError}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF9800"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#E65100"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID de envío" Binding="{Binding IdEnvio}" Width="120"/>
                    <DataGridTextColumn Header="Nombre de ubicación de destino" Binding="{Binding NombreUbicacionDestino}" Width="220"/>
                    <DataGridTextColumn Header="Street" Binding="{Binding Street}" Width="220"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="140"/>
                    <DataGridTextColumn Header="ID de ubicación de destino" Binding="{Binding IdUbicacionDestino}" Width="150"/>
                    <DataGridTextColumn Header="Peso (KG)" Binding="{Binding PesoKG}" Width="100"/>
                    <DataGridTextColumn Header="Volumen (CU. M)" Binding="{Binding VolumenCUM}" Width="120"/>
                    <DataGridTextColumn Header="Piezas" Binding="{Binding Piezas}" Width="80"/>
                    <DataGridTextColumn Header="ID de carga" Binding="{Binding IdCarga}" Width="110"/>
                    <DataGridTextColumn Header="Número de secuencia" Binding="{Binding NumeroSecuencia}" Width="130"/>
                    <DataGridTextColumn Header="ID de ubicación de origen" Binding="{Binding IdUbicacionOrigen}" Width="160"/>
                    <!--<DataGridTextColumn Header="Dirección de destino" Binding="{Binding DireccionDestino}" Width="220"/> -->
                    <!--<DataGridTextColumn Header="Corredor" Binding="{Binding Corredor}" Width="140"/> -->
                    <!--<DataGridTextColumn Header="Fecha/hora de llegada de la entrega (DD/MM/AAAA HH:MM)" Binding="{Binding FechaLlegada}" Width="220"/> -->
                    <!--<DataGridTextColumn Header="Estado operativo" Binding="{Binding EstadoOperativo}" Width="150"/> -->
                    <DataGridTextColumn Header="Nombre carrier" Binding="{Binding NombreCarrier}" Width="140"/>
                    <DataGridTextColumn Header="ID del transportista" Binding="{Binding IdTransportista}" Width="140"/>
                    <DataGridTextColumn Header="Vhc" Binding="{Binding Vhc}" Width="80"/>
                    <DataGridTextColumn Header="Costo Estandar" Binding="{Binding CostoEstandar}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <StatusBar Grid.Row="4">
            <!-- ✅ Semáforo de conexión -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ellipseConexion"
                             Width="12"
                             Height="12"
                             Fill="Gray"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="statusBarConexion"
                               Text=""
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,15,0"/>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem>
                <TextBlock x:Name="statusBarText" Text="Selecciona un archivo"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="statusBarErrores" Text="" Foreground="Red"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>