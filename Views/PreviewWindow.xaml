<Window x:Class="GestorEnvios.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👁️ Vista Previa - Datos Procesados" 
        Height="600" Width="1100"
        WindowStartupLocation="CenterOwner">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="📊 VISTA PREVIA DE DATOS PROCESADOS" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Foreground="#4CAF50"
                   Margin="0,0,0,10"/>

        <!-- Tabla igual a la principal -->
        <DataGrid Grid.Row="1" 
                  x:Name="dgPreview"
                  AutoGenerateColumns="True"
                  AlternatingRowBackground="#F5F5F5"
                  Margin="0,0,0,10"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  RowHeaderWidth="0"/>

        <!-- Botón Exportar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
            <TextBlock x:Name="txtCount" 
                       Text="Total: 0 registros"
                       FontSize="12"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
            
            <Button Content="📤 Exportar a Excel"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Padding="20,10"
                    Click="BtnExportar_Click"
                    Cursor="Hand"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>