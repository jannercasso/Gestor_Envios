<Window x:Class="GestorEnvios.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👁️ Vista Previa - Datos Procesados" 
        WindowState="Normal"
        Height="600" Width="1100"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <!-- Estilos para ScrollBars más delgados -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="📊 VISTA PREVIA DE DATOS PROCESADOS" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Foreground="#4CAF50"
                   Margin="0,0,0,10"/>

        <!-- Tabla - SIN AlternatingRowBackground -->
        <DataGrid Grid.Row="1" 
                  x:Name="dgPreview"
                  AutoGenerateColumns="False"
                  Margin="0,0,0,10"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  RowHeaderWidth="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <!-- Estilo para encabezados -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#32AC5C"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderBrush" Value="#2A8F4A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Estilo para filas y celdas -->
            <DataGrid.Resources>
                <!-- Desactivar el color azul por defecto -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#32AC5C"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#32AC5C"/>
                
                <!-- Estilo para celdas - Hereda el color de la fila -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Background}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#32AC5C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4AC87C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                
                <!-- Estilo para filas -->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#32AC5C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4AC87C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Shipment Number" Binding="{Binding ShipmentNumber}" Width="130"/>
                <DataGridTextColumn Header="Delivery" Binding="{Binding Delivery}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Shipment type" Binding="{Binding ShipmentType}" Width="100"/>
                <DataGridTextColumn Header="Ship-to party" Binding="{Binding ShipToParty}" Width="120"/>
                <DataGridTextColumn Header="Vehicle Type" Binding="{Binding VehicleType}" Width="100"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="150"/>
                <DataGridTextColumn Header="Service agent" Binding="{Binding ServiceAgent}" Width="120"/>
                <DataGridTextColumn Header="Name 1" Binding="{Binding Name1}" Width="150"/>
                <DataGridTextColumn Header="Delivery Date" Binding="{Binding DeliveryDate}" Width="120"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="80"/>
                <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="80"/>
                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"/>
                <DataGridTextColumn Header="Order Number" Binding="{Binding OrderNumber}" Width="120"/>
                <DataGridTextColumn Header="Street" Binding="{Binding Street}" Width="200"/>
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                <DataGridTextColumn Header="Fecha1" Binding="{Binding Fecha1}" Width="100"/>
                <DataGridTextColumn Header="Fecha2" Binding="{Binding Fecha2}" Width="100"/>
                <DataGridTextColumn Header="Tipo1" Binding="{Binding Tipo1}" Width="80"/>
                <DataGridTextColumn Header="Tipo2" Binding="{Binding Tipo2}" Width="80"/>
                <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" Width="120"/>
                <DataGridTextColumn Header="Secuencia" Binding="{Binding Secuencia}" Width="80"/>
                <DataGridTextColumn Header="Vhc" Binding="{Binding Vhc}" Width="80"/>
                <DataGridTextColumn Header="Costo Estándar" Binding="{Binding CostoEstandar}" Width="100"/>
                <DataGridTextColumn Header="Id Carga" Binding="{Binding IdCarga}" Width="100"/>
                <DataGridTextColumn Header="Centro Destino" Binding="{Binding CentroDestino}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botón Exportar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
            <TextBlock x:Name="txtCount" 
                       Text="Total: 0 registros"
                       FontSize="12"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>
            
            <Button Content="📤 Exportar a Excel"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Padding="20,10"
                    Click="BtnExportar_Click"
                    Cursor="Hand"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>